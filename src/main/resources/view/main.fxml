<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.cftecnologia.ordens.controller.MainController" prefWidth="1100" prefHeight="700" styleClass="root-app">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar"><ImageView fitHeight="48" preserveRatio="true"><image><Image url="@../images/ifrs.png"/></image></ImageView><VBox spacing="1"><Label text="Ordens de Serviço" styleClass="brand-title"/><Label text="IFRS – Campus Ibirubá" styleClass="brand-subtitle"/></VBox></HBox></top>
 <left><VBox spacing="8" prefWidth="205" styleClass="sidebar"><Label text="MENU PRINCIPAL" styleClass="section-caption"/><Button text="Visão geral" onAction="#mostrarInicio" maxWidth="Infinity" styleClass="nav-button"/><Button text="Clientes" onAction="#mostrarClientes" maxWidth="Infinity" styleClass="nav-button"/><Button text="Equipamentos" onAction="#mostrarEquipamentos" maxWidth="Infinity" styleClass="nav-button"/><Button text="Ordens de serviço" onAction="#mostrarOrdens" maxWidth="Infinity" styleClass="nav-button"/><Region VBox.vgrow="ALWAYS"/><Button text="Alterar senha" onAction="#trocarSenha" maxWidth="Infinity" styleClass="nav-button"/><Button text="Sair" onAction="#sair" maxWidth="Infinity" styleClass="nav-button"/></VBox></left>
 <center><VBox fx:id="painel" minHeight="0" spacing="12" styleClass="content"><Label id="rotuloPainel" text="PAINEL" styleClass="section-caption"/><Label fx:id="tituloPagina" styleClass="page-title"/><Label fx:id="descricaoPagina" wrapText="true" styleClass="page-description"/><VBox fx:id="resumo" spacing="14" VBox.vgrow="ALWAYS">
<ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"><content><VBox spacing="14">
<HBox spacing="10"><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="overview-card"><Label text="Abertos" wrapText="true" styleClass="section-caption"/><Label fx:id="abertas" text="—" styleClass="overview-number" style="-fx-text-fill: #2563eb;"/></VBox><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="overview-card"><Label text="Em andamento" wrapText="true" styleClass="section-caption"/><Label fx:id="andamento" text="—" styleClass="overview-number" style="-fx-text-fill: #a16207;"/></VBox><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="overview-card"><Label text="Concluídos" wrapText="true" styleClass="section-caption"/><Label fx:id="concluidas" text="—" styleClass="overview-number" style="-fx-text-fill: #15803d;"/></VBox><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="overview-card"><Label text="Cancelados" wrapText="true" styleClass="section-caption"/><Label fx:id="canceladas" text="—" styleClass="overview-number" style="-fx-text-fill: #b91c1c;"/></VBox></HBox><HBox spacing="10"><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="overview-card"><Label text="Clientes cadastrados" styleClass="section-caption"/><Label fx:id="clientes" text="—" styleClass="overview-number"/></VBox><VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="overview-card"><Label text="Equipamentos cadastrados" styleClass="section-caption"/><Label fx:id="equipamentos" text="—" styleClass="overview-number"/></VBox></HBox><VBox spacing="10" styleClass="overview-card"><Label text="Acesso rápido" styleClass="card-heading"/><FlowPane hgap="10" vgap="8"><Button text="Clientes" onAction="#mostrarClientes"/><Button text="Equipamentos" onAction="#mostrarEquipamentos"/><Button text="Ordens de serviço" onAction="#mostrarOrdens" styleClass="primary"/></FlowPane></VBox>
<VBox spacing="8" styleClass="overview-card"><HBox alignment="CENTER_LEFT" spacing="10"><Label text="Chamados recentes" styleClass="card-heading"/><Region HBox.hgrow="ALWAYS"/><Button text="Atualizar" onAction="#atualizarResumo"/></HBox><ListView fx:id="recentes" prefHeight="180" fixedCellSize="32"><placeholder><Label text="Nenhum chamado registrado."/></placeholder></ListView><Label fx:id="aviso" wrapText="true" styleClass="muted-text"/></VBox>
</VBox></content></ScrollPane></VBox></VBox></center>
</BorderPane>
